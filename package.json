{
  "name": "walking-tracker",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "npx -p node@20 node ./node_modules/expo/bin/cli start",
    "start:node20": "npx -p node@20 node ./node_modules/expo/bin/cli start",
    "android": "npx -p node@20 node ./node_modules/expo/bin/cli start --android",
    "android:node20": "npx -p node@20 node ./node_modules/expo/bin/cli start --android",
    "android:prebuild": "npx -p node@20 node ./node_modules/expo/bin/cli prebuild --platform android --non-interactive",
    "android:apk": "cd android && ./gradlew assembleRelease",
    "ios": "npx -p node@20 node ./node_modules/expo/bin/cli start --ios",
    "ios:node20": "npx -p node@20 node ./node_modules/expo/bin/cli start --ios",
    "web": "npx -p node@20 node ./node_modules/expo/bin/cli start --web",
    "web:node20": "npx -p node@20 node ./node_modules/expo/bin/cli start --web",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "expo": "~54.0.33",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.17",
    "expo-haptics": "~15.0.7",
    "expo-linear-gradient": "~15.0.8",
    "expo-sharing": "~14.0.7",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "~19.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
